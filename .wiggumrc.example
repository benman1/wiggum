# .wiggumrc - Wiggum configuration
# Place in project root or $HOME

# Agent CLI that runs the loop: claude | opencode | pi | codex (default: claude).
# Override for one run with `wiggum execute --agent <name>`.
# agent = claude

# Verification steps (run in order, waterfall style)
# Each "verify" line is a shell command. If it fails, the agent is asked to fix it.
# Each "autofix" line runs the command first (letting it self-correct, e.g. ruff --fix),
# then re-runs it to check. Only escalates to the agent if it still fails.

# --- Example: TypeScript/Node project ---
# verify = npm run type-check
# verify = npm test
# verify = npm run build
# autofix = npm run lint -- --fix

# --- Example: Python project ---
# autofix = ruff format app tests scripts && ruff check --fix app tests scripts
# verify = pytest

# Benchmark scripts (optional) — run after each iteration, output fed to the agent.
# Purely informational: helps the agent see if changes are improving metrics.
# benchmark = ./scripts/measure_bundle_size.sh
# benchmark = npx lighthouse http://localhost:3000 --output json --quiet | jq '.categories.performance.score'

# Max implementation iterations — stops early if all tasks complete or stalled (default: 30)
max_iterations = 30

# Max retries per validation cycle (default: 5)
max_validation_retries = 5

# Retries when an agent session itself dies mid-run (dropped connection, API
# error) rather than finishing its task. Set to 0 to fail on the first drop.
claude_retries = 2

# Reasoning effort: low | medium | high | xhigh | max (default: xhigh). Each
# agent maps this onto its own thinking/variant/reasoning-effort flag.
# effort = xhigh

# Permission mode for every wiggum-issued call, in Claude's vocabulary:
#   acceptEdits | auto | bypassPermissions | default | dontAsk | manual | plan
# Each agent maps it to its own sandbox/approval flags. Claude maps "default" to
# "manual". "auto" keeps a guardrail on an unattended run;
# "bypassPermissions" runs every action with no checks.
# When this line is absent, the built-in default is bypassPermissions.
permission_mode = auto

# Model used for planning and for execution -- set independently, since a plan
# is one short call and execution is many. Use a name in the selected agent's
# format (Claude alias, `provider/model` for opencode and pi). Override for a
# single run with `--model`. Leave unset to use the agent's own default.
# model_plan = sonnet
# model_execute = sonnet
